# Public site origin used for canonical URLs.
NEXT_PUBLIC_SITE_URL=https://campus.buildkre.com

# Existing Supabase project. Leave blank until the campus migration is approved and applied.
# Do not put the service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The app runs without these.
NEXT_PUBLIC_ARIGO_URL=https://arigo.buildkre.com

# Server-only. Same value passed to set_hosted_host_secret in the shared database.
# At least 16 characters. Do not prefix this with NEXT_PUBLIC_.
ARIGO_HOST_SECRET=
# Optional. Defaults to india-international-school.
ARIGO_HOST_SLUG=india-international-school
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_URL=
